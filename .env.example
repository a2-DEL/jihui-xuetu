# TEMPLATE ONLY: provision real keys in an external secret manager. Never commit .env.local.
MODEL_EXTERNAL_CALLS_ENABLED=false
DEEPSEEK_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_INPUT_CHARS=12000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=200
AI_GLOBAL_QPS=20
AI_USER_RPM=15
# Costs require an approved, verified per-million-token price; omit both to show 'unknown'.
# AI_INPUT_COST_PER_MILLION=REPLACE_WITH_APPROVED_RATE
# AI_OUTPUT_COST_PER_MILLION=REPLACE_WITH_APPROVED_RATE
# DEMO JSON only; no real student data. PostgreSQL preview requires a reviewed migration.
AI_CONVERSATION_STORAGE=json
AI_PG_SCHEMA_VERIFIED=false
# Server-only. NODE_ENV=production always disables demo identities regardless of this setting.
ENABLE_DEMO_IDENTITY=false

# Stage A IdP contract rehearsal (server-only). The app remains fail-closed in production.
# Do not set this true until an approved external IdP + draft DB tables exist in an ISOLATED pre-production environment.
OIDC_STAGE_A_PREVIEW=false
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
OIDC_REDIRECT_URI=https://app.example.invalid/api/auth/oidc/callback
DATABASE_URL=REPLACE_WITH_SECRET_MANAGER_VALUE
