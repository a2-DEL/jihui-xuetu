# Deny by default. Explicitly include only files needed to build/run this Next.js app.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!next.config.ts
!tsconfig.json
!next-env.d.ts
!postcss.config.mjs
!public/
!public/**
!src/
